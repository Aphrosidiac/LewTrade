# OpenRouter key (https://openrouter.ai/keys) — used for the verdict synthesis
# call to deepseek/deepseek-v4-flash.
OPENROUTER_API_KEY=
# Optional: if set, /api/analyze, /api/watchlist/scan, and watchlist writes
# require this value in the X-API-Key header. Leave blank to run unauthed
# (fine for local dev; set it in prod — the API is public otherwise).
LEWTRADE_API_KEY=
